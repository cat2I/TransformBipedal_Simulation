#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "Fulltrans"
    doc = """Generated from Composed Stage of root layer /tmp/tmphwca36iz/Fulltrans.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_Fulltrans_meshfixed_6bi9msub/usdex_Fulltrans_meshfixed/Fulltrans.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_Fulltrans_meshfixed_6bi9msub/temp_Fulltrans_meshfixed/Fulltrans_meshfixed.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "Fulltrans" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </Fulltrans/Physics/root_joint>,
        </Fulltrans/Physics/IMUleft_joint>,
        </Fulltrans/Physics/IMUright_joint>,
        </Fulltrans/Physics/Bubleft_joint>,
        </Fulltrans/Physics/Bubright_joint>,
        </Fulltrans/Physics/Hipleft_joint>,
        </Fulltrans/Physics/Twistleft_joint>,
        </Fulltrans/Physics/Kneeleft_joint>,
        </Fulltrans/Physics/Footleft_joint>,
        </Fulltrans/Physics/Hipright_joint>,
        </Fulltrans/Physics/Twistright_joint>,
        </Fulltrans/Physics/Kneeright_joint>,
        </Fulltrans/Physics/Footright_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </Fulltrans/Geometry/Baselink>,
        </Fulltrans/Geometry/Baselink/IMUleft>,
        </Fulltrans/Geometry/Baselink/IMUright>,
        </Fulltrans/Geometry/Baselink/Bubleft>,
        </Fulltrans/Geometry/Baselink/Bubleft/Hipleft>,
        </Fulltrans/Geometry/Baselink/Bubleft/Hipleft/Twistleft>,
        </Fulltrans/Geometry/Baselink/Bubleft/Hipleft/Twistleft/Kneeleft>,
        </Fulltrans/Geometry/Baselink/Bubleft/Hipleft/Twistleft/Kneeleft/Footleft>,
        </Fulltrans/Geometry/Baselink/Bubright>,
        </Fulltrans/Geometry/Baselink/Bubright/Hipright>,
        </Fulltrans/Geometry/Baselink/Bubright/Hipright/Twistright>,
        </Fulltrans/Geometry/Baselink/Bubright/Hipright/Twistright/Kneeright>,
        </Fulltrans/Geometry/Baselink/Bubright/Hipright/Twistright/Kneeright/Footright>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "Baselink" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "IMUleft" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "IMUright" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "Bubleft" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "Hipleft" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "Twistleft" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "Kneeleft" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "Footleft" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                            }
                        }
                    }
                }
            }

            over "Bubright" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "Hipright" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "Twistright" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "Kneeright" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "Footright" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "IMUleft_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "IMUright_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Bubleft_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Hipleft_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Twistleft_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Kneeleft_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Footleft_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Bubright_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Hipright_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Twistright_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Kneeright_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Footright_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

